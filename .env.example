NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_your_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_your_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Sanity: server-only credentials, never prefix these with NEXT_PUBLIC_.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Admin panel at /admin. Choose a unique password of at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
